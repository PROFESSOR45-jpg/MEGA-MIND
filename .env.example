# ─────────────────────────────────────────────────────────
# MEGA MIND BOT — Environment Variables
# Copy this file to .env and fill in your own values.
# ─────────────────────────────────────────────────────────

# --- Identity ---
BOT_NAME=MEGA MIND
OWNER_NAME=Your Name
# Digits only, no + and no spaces — e.g. 254712345678
OWNER_NUMBER=

# --- Session ---
# Paste the SESSION_ID shown by the session server (or by `npm run session`).
# Format looks like: MEGA~eyJjcmVkcyI6...
SESSION_ID=

# URL of your deployed mega-mind-sessions app (separate service).
SESSION_SERVER_URL=https://your-session-server.onrender.com

# Set to true ONLY if SESSION_ID above is a session-server id (looks like
# "MM_xxxxxxxx") rather than the full "MEGA~..." string, and you want the
# bot to fetch the real session automatically over HTTP at startup.
AUTO_FETCH_SESSION=false

# --- Behavior ---
PREFIX=.
# public = anyone can use the bot | private = owner only (auto-blocks others
# if AUTOBLOCK=true) | self = bot only responds to the owner's own messages
MODE=public

# --- Protection / auto-features ---
ANTIBUG=true
ANTIBUG_DELETE=true
ANTIBUG_BLOCK=false

AUTOBLOCK=false
AUTO_READ_MESSAGES=false

STATUS_REACT=false
STATUS_VIEW=false
STATUS_REACTION_EMOJIS=🔥,❤️,😍,👍,💯

COMMAND_STATUS_REACT=true

ANTILINK=false
ANTIDELETE=false
WELCOME=true
GOODBYE=true

COMMAND_COOLDOWN_SECONDS=3
